ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://fuellayer:fuellayer@localhost:5433/fuellayer
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=fuellayer://,http://localhost:8081
ONBOARDING_PREVIEW_RATE_LIMIT=10
STORE_SEARCH_RATE_LIMIT=20
GOOGLE_PLACES_API_KEY=
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Receipt images are sent only after the user selects Analyze.
# OpenRouter takes precedence when both keys are configured.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional: defaults to openai/gpt-4.1-mini through OpenRouter, gpt-4.1-mini directly.
RECEIPT_MODEL=

# Independent recipe-import worker model (shared provider credentials above)
RECIPE_IMPORT_MODEL=gpt-4.1-mini
