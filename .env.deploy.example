ENVIRONMENT=production
# Full SHA of the backend checkout selected for this Dokploy deployment.
RELEASE_SHA=
# PostgreSQL must be provisioned separately on dokploy-network. No public DB port.
DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/fuellayer
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=fuellayer://
CLERK_JWT_KEY=
CORS_ORIGINS=
GOOGLE_PLACES_API_KEY=
# Choose a provider. OpenRouter takes precedence if both are set.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
RECEIPT_MODEL=
RECIPE_IMPORT_MODEL=gpt-4.1-mini
